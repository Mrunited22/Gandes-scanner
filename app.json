{
  "expo": {
    "name": "Gandes Scanner",
    "slug": "gandes-scanner",
    "version": "1.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "gandes",
    "icon": "./assets/icon.png",

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080b11"
    },

    "assetBundlePatterns": ["**/*"],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gandes.scanner",
      "buildNumber": "3",
      "infoPlist": {
        "NSCameraUsageDescription": "Gandes Scanner membutuhkan akses kamera untuk memindai dokumen Anda.",
        "NSPhotoLibraryUsageDescription": "Gandes Scanner membutuhkan akses galeri untuk mengimpor gambar dokumen.",
        "NSFaceIDUsageDescription": "Gandes Scanner menggunakan Face ID untuk mengamankan dokumen Anda.",
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },

    "android": {
      "package": "com.gandes.scanner",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080b11"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VISUAL_USER_SELECTED",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },

    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },

    "plugins": [
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Gandes Scanner membutuhkan akses kamera untuk memindai dokumen Anda."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gandes Scanner membutuhkan akses galeri untuk mengimpor gambar dokumen.",
          "cameraPermission": "Gandes Scanner tidak menggunakan kamera untuk impor."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Gandes Scanner menggunakan Face ID untuk mengamankan dokumen Anda."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#080b11",
          "dark": {
            "backgroundColor": "#080b11"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "buildToolsVersion": "35.0.0",
            "kotlinVersion": "2.0.21",
            "usesCleartextTraffic": false,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ]
  }
}
